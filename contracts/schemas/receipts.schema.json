{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "receipts.schema.json",
  "title": "receipts",
  "description": "Host to client, answers receipt.query. missing lists the IDs the host has no record of.",
  "$ref": "envelope.schema.json",
  "required": ["re"],
  "properties": {
    "type": { "const": "receipts" },
    "payload": {
      "type": "object",
      "required": ["receipts", "missing"],
      "properties": {
        "receipts": { "type": "array", "items": { "$ref": "result.schema.json#/$defs/receipt" }, "maxItems": 100 },
        "missing": { "type": "array", "items": { "$ref": "envelope.schema.json#/$defs/uuid" }, "maxItems": 100, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  }
}
