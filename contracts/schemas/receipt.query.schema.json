{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "receipt.query.schema.json",
  "title": "receipt.query",
  "description": "Client to host. Ask for the outcome of earlier commands by request ID, for example after a reconnect. Never resend the command instead.",
  "$ref": "envelope.schema.json",
  "properties": {
    "type": { "const": "receipt.query" },
    "payload": {
      "type": "object",
      "required": ["request_ids"],
      "properties": {
        "request_ids": {
          "type": "array",
          "items": { "$ref": "envelope.schema.json#/$defs/uuid" },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
