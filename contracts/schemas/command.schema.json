{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command.schema.json",
  "title": "command",
  "description": "Client to host. One native edit request; the envelope id is the request ID. The host answers with exactly one result.",
  "$ref": "envelope.schema.json",
  "properties": {
    "type": { "const": "command" },
    "payload": {
      "type": "object",
      "$ref": "envelope.schema.json#/$defs/request",
      "required": ["base_revision", "source", "op", "args"],
      "properties": {
        "base_revision": { "description": "The latest document revision this client had applied.", "$ref": "envelope.schema.json#/$defs/revision" },
        "source": { "description": "How the user asked for it, shown in receipts and activity.", "enum": ["ui", "voice"] },
        "lease": { "description": "lease_id of a lease this actor holds that covers the target. Leave out to let the host check conflicts for this one command.", "$ref": "envelope.schema.json#/$defs/uuid" },
        "op": { "$ref": "#/$defs/op" },
        "target": { "$ref": "#/$defs/target" },
        "args": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "enum": ["object.add", "history.undo", "history.redo", "document.save", "sketch.create"] } } },
          "then": { "not": { "required": ["target"] } },
          "else": {
            "if": { "properties": { "op": { "const": "voice.run" } } },
            "then": true,
            "else": { "required": ["target"] }
          }
        },
        {
          "if": { "properties": { "op": { "enum": ["object.delete", "history.undo", "history.redo", "document.save"] } } },
          "then": { "properties": { "args": { "type": "object", "maxProperties": 0 } } }
        },
        { "if": { "properties": { "op": { "const": "object.add" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/add" } } } },
        { "if": { "properties": { "op": { "const": "object.move" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/move" } } } },
        { "if": { "properties": { "op": { "const": "object.rotate" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/rotate" } } } },
        { "if": { "properties": { "op": { "const": "object.scale" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/scale" } } } },
        { "if": { "properties": { "op": { "const": "sketch.create" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/sketch_create" } } } },
        { "if": { "properties": { "op": { "const": "sketch.add_line" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/sketch_line" } } } },
        { "if": { "properties": { "op": { "const": "sketch.add_rectangle" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/sketch_rectangle" } } } },
        { "if": { "properties": { "op": { "const": "sketch.add_circle" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/sketch_circle" } } } },
        { "if": { "properties": { "op": { "const": "sketch.constrain" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/sketch_constrain" } } } },
        { "if": { "properties": { "op": { "const": "sketch.set_dimension" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/sketch_set_dimension" } } } },
        { "if": { "properties": { "op": { "const": "voice.run" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/voice_run" } } } },
        { "if": { "properties": { "op": { "const": "object.spatial_edit" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/spatial_edit" } } } }
      ],
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "op": {
      "enum": [
        "object.add",
        "object.move",
        "object.rotate",
        "object.scale",
        "object.delete",
        "history.undo",
        "history.redo",
        "document.save",
        "sketch.create",
        "sketch.add_line",
        "sketch.add_rectangle",
        "sketch.add_circle",
        "sketch.constrain",
        "sketch.set_dimension",
        "voice.run",
        "object.spatial_edit"
      ]
    },
    "spatial_edit": {
      "description": "Commit one frozen native toolbar gesture to an object or exact base-mesh component. One release, one native Undo. Never an executable Blender operator.",
      "type": "object",
      "required": [
        "native_tool",
        "mode",
        "component",
        "indices",
        "topology_token",
        "delta"
      ],
      "properties": {
        "native_tool": {
          "enum": [
            "builtin.move",
            "builtin.rotate",
            "builtin.scale",
            "builtin.extrude_region",
            "builtin.extrude_region_move"
          ]
        },
        "mode": {
          "enum": [
            "OBJECT",
            "EDIT_MESH"
          ]
        },
        "component": {
          "enum": [
            "object",
            "vertex",
            "edge",
            "face"
          ]
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16383
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "topology_token": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "delta": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "translation": {
              "$ref": "envelope.schema.json#/$defs/coordinate3"
            },
            "rotation": {
              "$ref": "envelope.schema.json#/$defs/quat"
            },
            "scale": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": -0.001
                  },
                  {
                    "type": "number",
                    "minimum": 0.001,
                    "maximum": 1000
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "OBJECT"
              }
            }
          },
          "then": {
            "properties": {
              "component": {
                "const": "object"
              },
              "indices": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "component": {
                "enum": [
                  "vertex",
                  "edge",
                  "face"
                ]
              },
              "indices": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "native_tool": {
                "enum": [
                  "builtin.extrude_region",
                  "builtin.extrude_region_move"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "EDIT_MESH"
              },
              "component": {
                "const": "face"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "native_tool": {
                "enum": [
                  "builtin.move",
                  "builtin.extrude_region",
                  "builtin.extrude_region_move"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "delta": {
                "required": [
                  "translation"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "native_tool": {
                "enum": [
                  "builtin.rotate"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "delta": {
                "required": [
                  "rotation"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "native_tool": {
                "enum": [
                  "builtin.scale"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "delta": {
                "required": [
                  "scale"
                ]
              }
            }
          }
        }
      ]
    },
    "voice_run": {
      "description": "Run a candidate of voice.candidates: the resolution and the choice (1 to 3). Name the target exactly when the candidate needs_target.",
      "type": "object",
      "required": ["resolution", "choice"],
      "properties": {
        "resolution": { "$ref": "envelope.schema.json#/$defs/uuid" },
        "choice": { "type": "integer", "minimum": 1, "maximum": 3 }
      },
      "additionalProperties": false
    },
    "target": {
      "description": "The object or sketch to change, with the generation the client last saw.",
      "type": "object",
      "required": ["id", "generation"],
      "properties": {
        "id": { "$ref": "envelope.schema.json#/$defs/uuid" },
        "generation": { "$ref": "envelope.schema.json#/$defs/revision" }
      },
      "additionalProperties": false
    },
    "add": {
      "description": "Add a primitive. location: world meters. dimensions: bounding box size in meters (a cylinder's diameter is X and Y, its depth Z).",
      "type": "object",
      "required": ["primitive", "location", "dimensions"],
      "properties": {
        "primitive": { "enum": ["cube", "sphere", "cylinder"] },
        "location": { "$ref": "envelope.schema.json#/$defs/coordinate3" },
        "dimensions": { "$ref": "envelope.schema.json#/$defs/length3" }
      },
      "additionalProperties": false
    },
    "move": {
      "description": "by: world offset in meters. to: new world location in meters.",
      "oneOf": [
        {
          "type": "object",
          "required": ["by"],
          "properties": { "by": { "$ref": "envelope.schema.json#/$defs/coordinate3" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["to"],
          "properties": { "to": { "$ref": "envelope.schema.json#/$defs/coordinate3" } },
          "additionalProperties": false
        }
      ]
    },
    "rotate": {
      "description": "by: turn about a world axis through the object's origin, angle in radians. to: new world rotation quaternion [w, x, y, z].",
      "oneOf": [
        {
          "type": "object",
          "required": ["by"],
          "properties": {
            "by": {
              "type": "object",
              "required": ["axis", "angle"],
              "properties": {
                "axis": { "enum": ["X", "Y", "Z"] },
                "angle": { "type": "number", "minimum": -6.283186, "maximum": 6.283186 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["to"],
          "properties": { "to": { "$ref": "envelope.schema.json#/$defs/quat" } },
          "additionalProperties": false
        }
      ]
    },
    "scale": {
      "description": "by: multiply the object's scale along its own axes. to: new scale factors.",
      "oneOf": [
        {
          "type": "object",
          "required": ["by"],
          "properties": { "by": { "$ref": "envelope.schema.json#/$defs/factor3" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["to"],
          "properties": { "to": { "$ref": "envelope.schema.json#/$defs/factor3" } },
          "additionalProperties": false
        }
      ]
    },
    "sketch_create": {
      "description": "New sketch on a world plane through the origin.",
      "type": "object",
      "required": ["plane"],
      "properties": { "plane": { "enum": ["XY", "XZ", "YZ"] } },
      "additionalProperties": false
    },
    "sketch_line": {
      "description": "Two new points joined by a line. Sketch coordinates in meters.",
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "envelope.schema.json#/$defs/coordinate2" },
        "end": { "$ref": "envelope.schema.json#/$defs/coordinate2" }
      },
      "additionalProperties": false
    },
    "sketch_rectangle": {
      "description": "Four lines sharing four corner points, with horizontal and vertical constraints.",
      "type": "object",
      "required": ["corner", "opposite"],
      "properties": {
        "corner": { "$ref": "envelope.schema.json#/$defs/coordinate2" },
        "opposite": { "$ref": "envelope.schema.json#/$defs/coordinate2" }
      },
      "additionalProperties": false
    },
    "sketch_circle": {
      "description": "A new center point and a circle.",
      "type": "object",
      "required": ["center", "radius"],
      "properties": {
        "center": { "$ref": "envelope.schema.json#/$defs/coordinate2" },
        "radius": { "$ref": "envelope.schema.json#/$defs/length" }
      },
      "additionalProperties": false
    },
    "sketch_constrain": {
      "description": "Add a constraint between entities of the target sketch. value: meters for distance and diameter, radians for angle.",
      "type": "object",
      "required": ["kind", "entities"],
      "properties": {
        "kind": { "$ref": "scene.snapshot.schema.json#/$defs/constraint_kind" },
        "entities": { "type": "array", "items": { "$ref": "envelope.schema.json#/$defs/local_id" }, "minItems": 1, "maxItems": 2, "uniqueItems": true },
        "value": { "type": "number" }
      },
      "additionalProperties": false,
      "allOf": [
        { "$ref": "scene.snapshot.schema.json#/$defs/constraint_value_rule" },
        {
          "if": { "properties": { "kind": { "enum": ["distance", "diameter"] } }, "required": ["kind"] },
          "then": { "properties": { "value": { "$ref": "envelope.schema.json#/$defs/length" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "angle" } }, "required": ["kind"] },
          "then": { "properties": { "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 3.141593 } } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["coincident", "angle"] } }, "required": ["kind"] },
          "then": { "properties": { "entities": { "minItems": 2 } } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["diameter", "fixed"] } }, "required": ["kind"] },
          "then": { "properties": { "entities": { "maxItems": 1 } } }
        }
      ]
    },
    "sketch_set_dimension": {
      "description": "Change the value of an existing distance, angle or diameter constraint. The host checks the range for the constraint's kind.",
      "type": "object",
      "required": ["constraint", "value"],
      "properties": {
        "constraint": { "$ref": "envelope.schema.json#/$defs/local_id" },
        "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
      },
      "additionalProperties": false
    }
  }
}
