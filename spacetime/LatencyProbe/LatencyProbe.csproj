<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike: stands in for the Unity app. Subscribes to the lease table through the official
       SpacetimeDB C# client SDK and prints when each change arrives. See ../README.md.
       module_bindings/ is generated (spacetime generate) and not committed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpacetimeDB.ClientSDK" Version="2.13.0" />
  </ItemGroup>

</Project>
