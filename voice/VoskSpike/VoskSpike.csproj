<Project Sdk="Microsoft.NET.Sdk">

  <!-- Measures real Vosk recognition through the package's recognizer, VoiceInput and PcmConverter. Not in Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../VoiceCore/Runtime/**/*.cs" Link="Runtime/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../VoiceCore/Vosk/**/*.cs" Link="Vosk/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only for libvosk next to the program (the binaries voice/fetch-vosk.sh gives Unity); not its Vosk.dll. -->
    <PackageReference Include="Vosk" Version="0.3.38" ExcludeAssets="compile;runtime" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

</Project>
